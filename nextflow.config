params {
	ar_guid                           = "tg_shared-test_workspace_test"
    input_vds                         = null
    output_vds                        = null
    cohorts                           = 'COH5491'
    metamist_project                  = 'thousand-genomes'
    expected_sg_count                 = null
    force_new                         = true
    outdir                            = 'gs://cpg-thousand-genomes-test'
    bcftools_container                = 'australia-southeast1-docker.pkg.dev/cpg-common/images/nf_bcftools:1.23.1-2'

    // content previously in a toml
    sequencing_type                   = 'genome'
    intervals                         = 'gs://cpg-common-main/references/hail_intervals/hg38/gnomad_v4.1_variants_balanced_intervals.bed.gz'
    // target_records is the OurDNA cpg-flow default; the other two are tuned for checkpoint frequency.
    target_records                    = 1000000
    branch_factor                     = 100
    gvcf_batch_size                   = 5

    // Dataproc / Hail options
    gcp_project                       = 'thousand-genomes'
    dataproc_container                = 'australia-southeast1-docker.pkg.dev/cpg-common/images-dev/seqera_trial:0.0.1-1'
    dataproc_staging_bucket           = 'gs://cpg-thousand-genomes-test'
    dataproc_temp_bucket              = 'gs://cpg-thousand-genomes-test'
    dataproc_master_type              = 'n1-highmem-8'
    dataproc_worker_type              = 'n1-highmem-16'
    dataproc_num_workers              = 2
    dataproc_num_secondary_workers    = 4
    preemptible_secondary_workers     = true
    dataproc_internal_ip_only         = false
    dataproc_boot_disk_size_gb        = 100
    dataproc_num_local_ssds           = 1
    // Cluster VMs run as this SA so they inherit the dataset access (not the default compute SA).
    dataproc_service_account          = 'seqera-test@thousand-genomes.iam.gserviceaccount.com'

    // Autoscaling options
    // trial-combiner-1 ceiling: 2 fixed primary + up to 20 secondary workers.
    dataproc_autoscaling_policy       = 'projects/cpg-common/regions/australia-southeast1/autoscalingPolicies/cpg-common-combiner-1'

    // TTL options
    dataproc_max_age                  = 172800
    dataproc_max_idle                 = 600
}

// this sets workflow outputs, but is only available in a workflow with an output block defined.
outputDir = params.outdir

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
}

manifest {
    name            = 'cohort_demo'
    description     = 'A stripped back demo for Seqera Platform'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04.0'
    version         = '1.0.0'
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.1.1'
}

// copy workflow outputs
workflow.output.mode = 'copy'

process {
	resourceLabels = [
        'ar-guid': params.ar_guid,
        'dataset': params.metamist_project,
        'compute-category': 'nextflow',
    ]
    executor = 'google-batch'
    container = 'australia-southeast1-docker.pkg.dev/cpg-common/images-dev/seqera_metamist:7.14.0-1'
}

google {
    project   = 'thousand-genomes'
    region    = 'australia-southeast1'

    batch {
        spot = false
        serviceAccountEmail = params.dataproc_service_account
    }
}
